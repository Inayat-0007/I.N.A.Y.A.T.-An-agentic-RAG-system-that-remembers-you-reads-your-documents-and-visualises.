# ==============================================================================
# I.N.A.Y.A.T. environment template
# Copy this file to ".env" and replace placeholders. Never commit .env.
# Cloud APIs (Gemini, Mem0, Neo4j Aura) run outside Docker — you bring the keys.
# ==============================================================================

# --- Required ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Recommended (memory + graph degrade gracefully if missing) ---
# Mem0 Platform: https://app.mem0.ai/
MEM0_API_KEY=your_mem0_api_key_here

# Neo4j AuraDB (free instance): https://neo4j.com/cloud/aura/
# URI looks like: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=neo4j+s://your-db-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- Optional I.N.A.Y.A.T. tuning (defaults shown) ---
# INAYAT_LLM_MODEL=gemini-flash-lite-latest
# INAYAT_EMBED_MODEL=gemini-embedding-001
# INAYAT_CHUNK_SIZE=512
# INAYAT_CHUNK_OVERLAP=64
# INAYAT_TOP_K=5
# INAYAT_MMR_ENABLED=false
# INAYAT_MMR_LAMBDA=0.7
# INAYAT_MAX_UPLOAD_BYTES=10485760
# INAYAT_DEMO_MODE=false
# Optional API gate (empty = open demo). If set, mutating routes need X-INAYAT-KEY.
# INAYAT_API_KEY=
# INAYAT_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# INAYAT_LOG_LEVEL=INFO
# INAYAT_ALLOW_EMPTY_FROM_EXISTING=false
# INAYAT_SYNC_INGEST=true
# INAYAT_MEMORY_CONTEXT_MAX_CHARS=2000
