# Secrets and VCS — never bake .env into the image (Compose injects it at runtime)
.git
.github
.env
.env.*
!.env.example

# Local toolchains (the SPA image builds frontend/ with npm ci)
.venv
venv
env
ENV
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
node_modules
frontend/node_modules
frontend/dist

*.log
inayat_debug.log
.DS_Store
Thumbs.db
.vscode
.idea

# Host uploads; Compose bind-mounts ./data. Keep seed PDFs in the image.
data/documents/*
!data/documents/.gitkeep
!data/documents/_samples/
!data/documents/_samples/**
